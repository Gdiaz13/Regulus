<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Regulas.MauiApp.Controls"
             x:Class="Regulas.MauiApp.MainPage"
             x:Name="HomeRoot"
             Title="Regulas">
    <RefreshView IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout x:Name="PageBody"
                                 Spacing="16"
                                 Opacity="0">

                <!-- The sky panel keeps its night colours in both themes: it is a
                     brand surface, the way a photograph would be. -->
                <Grid HeightRequest="300">
                    <controls:StarFieldView x:Name="Sky"
                                            EmptyText="Tap a star in Leo" />
                    <VerticalStackLayout Padding="28,26"
                                         Spacing="10"
                                         VerticalOptions="Start">
                        <Label Text="Regulas"
                               FontSize="44"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Portfolio and research gateway"
                               FontSize="15"
                               TextColor="{StaticResource Gray200}" />
                        <Label Text="{Binding AccountText}"
                               FontSize="13"
                               TextColor="{StaticResource Gray300}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Padding="28,22"
                                           Spacing="10"
                                           VerticalOptions="End">
                        <Ellipse Fill="{StaticResource Secondary}"
                                 WidthRequest="7"
                                 HeightRequest="7"
                                 VerticalOptions="Center" />
                        <Label Text="{Binding Source={x:Reference Sky}, Path=SelectedStarName}"
                               FontSize="13"
                               TextColor="{StaticResource Secondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Refresh"
                            Margin="28,22"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding CanRefresh}" />
                </Grid>

                <VerticalStackLayout Padding="20,0,20,24"
                                     Spacing="16"
                                     MaximumWidthRequest="980"
                                     HorizontalOptions="Center">

                    <Button Text="Sign in"
                            HorizontalOptions="Start"
                            Command="{Binding OpenAccountCommand}"
                            IsVisible="{Binding IsAnonymous}" />

                    <Border Stroke="{AppThemeBinding Light={StaticResource RegulasLightBorder}, Dark={StaticResource RegulasDarkBorder}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RegulasLightSurface}, Dark={StaticResource RegulasDarkSurface}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="24"
                              RowSpacing="4">
                            <Label Text="{Binding StatusText}"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                            <Label Grid.Column="1"
                                   Text="{Binding DatabaseText}"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                            <Label Grid.Column="2"
                                   Text="{Binding MarketDataText}"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                            <ActivityIndicator Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               IsRunning="{Binding IsBusy}"
                                               IsVisible="{Binding IsBusy}"
                                               HorizontalOptions="Start" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasError}"
                            Stroke="{StaticResource RegulasDanger}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource RegulasLightSurface}, Dark={StaticResource RegulasDarkSurface}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="14">
                        <Label Text="{Binding ErrorText}"
                               TextColor="{StaticResource RegulasDanger}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding IsAuthenticated}">
                        <Label Text="Portfolio"
                               FontSize="20"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="Brightness follows market cap"
                               VerticalOptions="End"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Stocks}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsAuthenticated}">
                        <CollectionView.EmptyView>
                            <Label Text="No saved stocks yet. Add one from Search and it joins the sky."
                                   HorizontalTextAlignment="Center"
                                   Padding="20"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{AppThemeBinding Light={StaticResource RegulasLightBorder}, Dark={StaticResource RegulasDarkBorder}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource RegulasLightSurface}, Dark={StaticResource RegulasDarkSurface}}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1.01" />
                                                    <Setter Property="Stroke" Value="{StaticResource Secondary}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="14">
                                        <Ellipse Grid.RowSpan="2"
                                                 Fill="{StaticResource Secondary}"
                                                 WidthRequest="{Binding StarSize}"
                                                 HeightRequest="{Binding StarSize}"
                                                 Opacity="{Binding StarOpacity}"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Symbol}"
                                               FontAttributes="Bold"
                                               FontSize="18" />
                                        <Label Grid.Column="2"
                                               Text="{Binding PurchasePrice, StringFormat='${0:N2}'}"
                                               FontAttributes="Bold" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding CompanyName}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                                        <Label Grid.Row="1"
                                               Grid.Column="2"
                                               Text="{Binding Industry}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                                        <HorizontalStackLayout Grid.Row="2"
                                                               Grid.ColumnSpan="3"
                                                               Spacing="8"
                                                               HorizontalOptions="End">
                                            <Button Text="Details"
                                                    Command="{Binding Source={x:Reference HomeRoot}, Path=BindingContext.OpenStockCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Manage"
                                                    Command="{Binding Source={x:Reference HomeRoot}, Path=BindingContext.ManageStockCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Remove"
                                                    Command="{Binding Source={x:Reference HomeRoot}, Path=BindingContext.RemoveStockCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
